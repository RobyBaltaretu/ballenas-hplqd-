[Unit]
Description=Panel web del bot de ballenas
After=network-online.target

[Service]
Type=simple
User=botballenas
WorkingDirectory=/opt/bot-ballenas
ExecStart=/opt/bot-ballenas/.venv/bin/python -u panel.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
